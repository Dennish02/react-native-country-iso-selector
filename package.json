{
  "name": "react-native-country-iso-selector",
  "version": "2.0.0",
  "description": "Una librería de React Native que proporciona un selector de países con códigos ISO, banderas y códigos telefónicos internacionales, compatible con aplicaciones móviles y web, y personalizable para adaptarse al diseño de tu aplicación. La presentación es totalmente personalizable como incluirlo en un popover, modal, view, etc.",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "audit": "npm audit --audit-level=high"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "peerDependencies": {
    "react": ">=18.2.0",
    "react-native": ">=0.71.0"
  },
  "keywords": [
    "react-native",
    "country",
    "country-picker",
    "iso",
    "flags",
    "phone-code"
  ],
  "author": "Hesler Dennis",
  "license": "ISC",
  "devDependencies": {
    "@types/react": "^19.3.0",
    "react": "^19.3.1",
    "react-native": "^0.88.0",
    "typescript": "^7.0.2"
  },
  "files": [
    "src",
    "screenshots"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Dennish02/react-native-country-iso-selector"
  },
  "bugs": {
    "url": "https://github.com/Dennish02/react-native-country-iso-selector/issues"
  },
  "homepage": "https://github.com/Dennish02/react-native-country-iso-selector#readme"
}
